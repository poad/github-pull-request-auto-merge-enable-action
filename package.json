{
  "name": "github-pull-request-auto-merge-enable-action",
  "version": "1.0.5",
  "license": "MIT",
  "author": "Kenji Saito <ken-yo@mbr.nifty.com>",
  "repository": "https://github.com/poad/github-pull-request-auto-merge-enable-action.git",
  "type": "module",
  "main": "./dist/entry-point.js",
  "exports": {
    ".": {
      "node": "./dist/main.js",
      "require": "./dist/main.cjs",
      "default": "./dist/main.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig-build.json",
    "lint-fix": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint",
    "test": "vitest run --silent=true --coverage --max-workers=1",
    "package": "bunx @vercel/ncc build -o dist --source-map --license licenses.txt -q --target es2023",
    "clean": "rm -rf dist",
    "all": "bun run --bun clean && bun run --bun build && bun run --bun package && pnpm lint-fix && bun run --vitest test"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@octokit/core": "^7.0.8",
    "@octokit/graphql": "^9.0.5",
    "@octokit/plugin-request-log": "^6.0.0",
    "source-map-support": "^0.5.21"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vercel/ncc": "^0.45.0",
    "@vitest/coverage-v8": "^5.1.0",
    "baseline-browser-mapping": "^2.11.35",
    "fetch-mock": "^12.6.0",
    "jiti": "^2.7.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.20.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
}
